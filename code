import argparse
from pathlib import Path

import folium
import geopandas as gpd
from shapely.geometry import box


DEFAULT_DATA_PATH = Path("./A31-21_33_GML/A31a-21_33.shp")
DEFAULT_OUTPUT = Path("kurashiki_flood_map_perfect.html")


def resolve_data_path(path: str | None) -> Path:
    candidates = []
    if path:
        candidates.append(Path(path))
    candidates.extend([
        Path.cwd() / "A31-21_33_GML" / "A31a-21_33.shp",
        Path(__file__).resolve().parent / "A31-21_33_GML" / "A31a-21_33.shp",
    ])

    for candidate in candidates:
        if candidate.exists():
            return candidate

    return Path(path) if path else DEFAULT_DATA_PATH


def main():
    parser = argparse.ArgumentParser(description="倉敷市周辺の浸水リスク地図を生成します。")
    parser.add_argument("--data", type=str, help="対象の Shapefile パス")
    parser.add_argument("--output", type=str, default=str(DEFAULT_OUTPUT), help="出力 HTML ファイル名")
    args = parser.parse_args()

    data_path = resolve_data_path(args.data)
    output_path = Path(args.output)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    if not data_path.exists():
        raise FileNotFoundError(
            f"データが見つかりませんでした: {data_path}\n"
            "A31-21_33_GML/A31a-21_33.shp を配置してから実行してください。"
        )

    print(f"データを読み込んでいます: {data_path}")
    gdf = gpd.read_file(data_path, encoding="cp932")

    if gdf.crs is None:
        gdf.set_crs(epsg=4612, inplace=True)
    gdf = gdf.to_crs(epsg=4326)

    print("指定範囲でデータをクリッピングしています...")
    bbox = box(133.72, 34.56, 133.80, 34.63)
    gdf_clipped = gdf.clip(bbox)

    if len(gdf_clipped) == 0:
        raise ValueError("指定した範囲にデータがありません。bbox を確認してください。")

    target_col = "A31a_205"
    if target_col not in gdf_clipped.columns:
        raise KeyError(f"対象カラム {target_col} が見つかりません。データ形式を確認してください。")

    depth_mapping = {
        1: "0.5m未満",
        2: "0.5m ～ 3.0m未満",
        3: "3.0m ～ 5.0m未満",
        4: "5.0m ～ 10.0m未満",
        5: "10.0m ～ 20.0m未満",
        6: "20.0m以上",
    }
    gdf_clipped = gdf_clipped.copy()
    gdf_clipped.loc[:, "浸水深_m"] = gdf_clipped[target_col].map(depth_mapping)
    gdf_clipped.loc[:, "河川名"] = gdf_clipped.get("A31a_202", "不明")

    bounds = gdf_clipped.total_bounds
    center_lat = (bounds[1] + bounds[3]) / 2
    center_lon = (bounds[0] + bounds[2]) / 2
    m = folium.Map(location=[center_lat, center_lon], zoom_start=14)

    def get_color(feature):
        rank = feature["properties"].get(target_col)
        try:
            rank = int(rank)
        except (TypeError, ValueError):
            return "#cccccc"

        return {
            1: "#ffffb2",
            2: "#ffcc00",
            3: "#ff9900",
            4: "#ff3300",
            5: "#cc0000",
            6: "#800000",
        }.get(rank, "#cccccc")

    print("地図を生成しています...")
    folium.GeoJson(
        gdf_clipped,
        style_function=lambda feature: {
            "fillColor": get_color(feature),
            "color": get_color(feature),
            "weight": 0.8,
            "fillOpacity": 0.7,
        },
        tooltip=folium.GeoJsonTooltip(
            fields=["河川名", "浸水深_m"],
            aliases=["対象河川:", "想定浸水深:"],
            localize=True,
        ),
    ).add_to(m)

    output_path = output_path.resolve()
    m.save(output_path)
    print(f"完了しました！ {output_path} をブラウザで開いて確認してください。")


if __name__ == "__main__":
    main()